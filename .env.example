# Copy this file to .env.local and fill in real values.
# Never commit .env.local or other secret env files.

# --- Public (safe in the browser) ---

# Public site origin used in Deal and Article promotion copy, enquiry emails, sitemap, and robots.
# No trailing slash. Local example: http://localhost:3000
NEXT_PUBLIC_SITE_URL=

# Supabase — Settings → API Keys
# Publishable key starts with sb_publishable_ and is safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Server only ---

# Secret key starts with sb_secret_ and must never be exposed to the browser.
# Used only to load Entity email after an Enquiry is stored, so mail can be sent.
# If unset, the Enquiry is still saved and the visitor still sees success.
SUPABASE_SECRET_KEY=

# Resend API key. Leave empty to skip sending mail.
RESEND_API_KEY=

# Transactional sender, for example: OperatorTemplate <hello@example.com>
# Required only if RESEND_API_KEY is set.
MAIL_FROM=

# Displayed on Entity enquiry emails if you need to override config/business.ts
# without a rebuild. Leave empty to use BUSINESS.name.
PLATFORM_NAME=

# Operator receives an informational notification after each stored Enquiry.
OPERATOR_NOTIFICATION_EMAIL=

# Production: disable public signup in Supabase Auth (Authentication → Providers / sign-ups).
# OperatorTemplate has no registration UI. Any authenticated user currently has operator database access.
